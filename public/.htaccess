<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Permitir que el manifest.json y los iconos sean accesibles directamente
    RewriteRule ^manifest.json$ - [L]
    RewriteRule ^icons/ - [L]

    # Reescribir otras URLs a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
